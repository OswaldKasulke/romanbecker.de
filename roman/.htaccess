# Roman Becker — URL-Routing
# Stand: 2026-05-11

Options -MultiViews

# Lead-Backup-Log enthält personenbezogene Daten — nie öffentlich zugänglich machen
<Files "leads.log">
  Require all denied
</Files>

# Zeichensatz UTF-8 im HTTP-Header
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .json .xml .txt

RewriteEngine On

# Eine kanonische Adresse in genau einem Schritt: HTTPS und ohne www.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^romanbecker\.de$ [NC]
RewriteRule ^ https://romanbecker.de%{REQUEST_URI} [R=301,L,NE]

# Sicherheitsheader fuer alle ausgelieferten Dateien.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://www.googletagmanager.com https://maps.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https://images.ctfassets.net https://www.google-analytics.com https://www.googletagmanager.com https://maps.gstatic.com https://maps.googleapis.com; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://maps.googleapis.com; frame-src 'self' https://www.google.com https://www.openstreetmap.org; upgrade-insecure-requests"
</IfModule>

# Arbeitsdateien sperren: /scripts/ (Generatoren) und /data/ (Straßenverzeichnis
# der Stadt, Master, Veedel-Preise) werden von keiner Seite geladen und gehören
# nicht ins Web. Der FTP-Deploy laedt sie seit 22.08.2026 nicht mehr hoch,
# loescht aber nicht, was schon oben liegt — diese Regel sperrt beides zuverlaessig.
RewriteRule ^(scripts|data)/ - [F,L]

# Kurz-URLs auf die Angebots-Sektion der Startseite (fuer Google-Profil, Flyer, QR)
RewriteRule ^objekte/?$   /#objekte-koeln [R=301,L,NE]
RewriteRule ^immobilien/?$ /#objekte-koeln [R=301,L,NE]
RewriteRule ^angebote/?$   /#objekte-koeln [R=301,L,NE]

# Nießbrauch-Seiten: alte Einfach-s-Slugs -> korrekte Doppel-s-Slugs (301)

# Weitere Zusammenlegungen duenner Ratgeber-Seiten
# Marktanalyse-Uebersicht entfernt - Inhalt steckt im Ratgeber-Artikel
RewriteRule ^marktanalyse/?$ /ratgeber/grundstuecksmarktbericht-koeln.html [R=301,L]
# Marktbericht: folgt dem jaehrlichen Grundstuecksmarktbericht statt dem
# Quartal und sitzt seit 21.08.2026 im Ratgeber-Silo. Alle Altadressen zeigen
# direkt auf das Ziel, keine Ketten.
RewriteRule ^marktanalyse/koeln-q2-2026\.html$ /ratgeber/marktanalyse.html [R=301,L]
RewriteRule ^marktanalyse/koeln-q3-2026\.html$ /ratgeber/marktanalyse.html [R=301,L]
RewriteRule ^marktanalyse/koeln-2026\.html$    /ratgeber/marktanalyse.html [R=301,L]
RewriteRule ^ratgeber/hypothek\.html$ /ratgeber/grundschuld.html [R=301,L]
RewriteRule ^ratgeber/smart-heizung\.html$ /ratgeber/smarthome.html [R=301,L]
RewriteRule ^ratgeber/vergleichsmiete\.html$ /mietspiegel.html [R=301,L]
RewriteRule ^ratgeber/mietspiegel\.html$ /mietspiegel.html [R=301,L]
RewriteRule ^mietspiegel-koeln\.html$ /mietspiegel.html [R=301,L]

# Zusammengelegt zu fenster-tueren-dach.html (vier duenne Einzelseiten)
RewriteRule ^ratgeber/fenster\.html$ /ratgeber/fenster-tueren-dach.html [R=301,L]
RewriteRule ^ratgeber/verglasung\.html$ /ratgeber/fenster-tueren-dach.html [R=301,L]
RewriteRule ^ratgeber/daecher\.html$ /ratgeber/fenster-tueren-dach.html [R=301,L]
RewriteRule ^ratgeber/haustueren\.html$ /ratgeber/fenster-tueren-dach.html [R=301,L]

RewriteRule ^ratgeber/niesbrauch-wohnrecht\.html$      /ratgeber/niessbrauch-wohnrecht.html      [R=301,L]
RewriteRule ^ratgeber/niesbrauch-kapitalisieren\.html$ /ratgeber/niessbrauch-kapitalisieren.html [R=301,L]

# Leverkusen-Seiten entfernt (09.08.2026) -> Uebersichten (301)
RewriteRule ^bodenrichtwert-leverkusen\.html$ /bodenrichtwert-koeln.html [R=301,L]


# Eschweiler entfernt (14.08.2026, Staedteregion Aachen ausserhalb des Einzugsgebiets) -> Uebersichten (301)
RewriteRule ^bodenrichtwert-eschweiler\.html$ /bodenrichtwert-koeln.html [R=301,L]

RewriteRule ^stadtteile/eschweiler\.html$ /stadtteile/ [R=301,L]

# Rhein-Sieg-Kreis komplett entfernt (15.08.2026) -> Uebersichten (301)
RewriteRule ^stadtteile/alfter\.html$ /stadtteile/ [R=301,L]
RewriteRule ^stadtteile/bornheim\.html$ /stadtteile/ [R=301,L]
RewriteRule ^stadtteile/lohmar\.html$ /stadtteile/ [R=301,L]
RewriteRule ^stadtteile/much\.html$ /stadtteile/ [R=301,L]
RewriteRule ^stadtteile/neunkirchen-seelscheid\.html$ /stadtteile/ [R=301,L]
RewriteRule ^stadtteile/niederkassel\.html$ /stadtteile/ [R=301,L]
RewriteRule ^stadtteile/sankt-augustin\.html$ /stadtteile/ [R=301,L]
RewriteRule ^stadtteile/swisttal\.html$ /stadtteile/ [R=301,L]
RewriteRule ^stadtteile/troisdorf\.html$ /stadtteile/ [R=301,L]
RewriteRule ^immobilienmakler-rhein-sieg/alfter/?$ /stadtteile/ [R=301,L]
RewriteRule ^immobilienmakler-rhein-sieg/bornheim/?$ /stadtteile/ [R=301,L]
RewriteRule ^immobilienmakler-rhein-sieg/lohmar/?$ /stadtteile/ [R=301,L]
RewriteRule ^immobilienmakler-rhein-sieg/much/?$ /stadtteile/ [R=301,L]
RewriteRule ^immobilienmakler-rhein-sieg/neunkirchen-seelscheid/?$ /stadtteile/ [R=301,L]
RewriteRule ^immobilienmakler-rhein-sieg/niederkassel/?$ /stadtteile/ [R=301,L]
RewriteRule ^immobilienmakler-rhein-sieg/sankt-augustin/?$ /stadtteile/ [R=301,L]
RewriteRule ^immobilienmakler-rhein-sieg/swisttal/?$ /stadtteile/ [R=301,L]
RewriteRule ^immobilienmakler-rhein-sieg/troisdorf/?$ /stadtteile/ [R=301,L]
RewriteRule ^immobilienmakler-rhein-sieg/?$ /stadtteile/ [R=301,L]

# Kreis Dueren entfernt (15.08.2026): Fokus auf Koeln und Rhein-Erft -> Uebersichten (301)
RewriteRule ^stadtteile/dueren\.html$ /stadtteile/ [R=301,L]
RewriteRule ^stadtteile/juelich\.html$ /stadtteile/ [R=301,L]
RewriteRule ^bodenrichtwert-dueren\.html$ /bodenrichtwert-koeln.html [R=301,L]
RewriteRule ^bodenrichtwert-juelich\.html$ /bodenrichtwert-koeln.html [R=301,L]

# Bergisches Land (29.08.2026): statt auf die Koelner Uebersicht jetzt auf die
# Schwesterseite immobilienmakler-bergisch-gladbach.de, die diese Orte abdeckt.
# Vorher liefen diese URLs auf /stadtteile/ - thematisch unpassend, Google
# wertet so etwas als Soft-404. Das [NE] ist Pflicht: ohne den Schalter macht
# Apache aus dem # ein %23 und das Ziel wird ein 404 (siehe /kontakt/).
RewriteRule ^stadtteile/bergisch-gladbach\.html$ https://immobilienmakler-bergisch-gladbach.de/ [R=301,L,NE]
RewriteRule ^immobilienmakler-rheinisch-bergisch/bergisch-gladbach/?$ https://immobilienmakler-bergisch-gladbach.de/ [R=301,L,NE]
RewriteRule ^stadtteile/odenthal\.html$ https://immobilienmakler-bergisch-gladbach.de/odenthal/ [R=301,L,NE]
RewriteRule ^immobilienmakler-rheinisch-bergisch/odenthal/?$ https://immobilienmakler-bergisch-gladbach.de/odenthal/ [R=301,L,NE]
RewriteRule ^stadtteile/overath\.html$ https://immobilienmakler-bergisch-gladbach.de/overath/ [R=301,L,NE]
RewriteRule ^immobilienmakler-rheinisch-bergisch/overath/?$ https://immobilienmakler-bergisch-gladbach.de/overath/ [R=301,L,NE]
# Ohne eigene Ortsseite auf der Schwesterseite -> Staedte-Uebersicht dort
RewriteRule ^stadtteile/leichlingen\.html$ https://immobilienmakler-bergisch-gladbach.de/#staedte [R=301,L,NE]
RewriteRule ^immobilienmakler-rheinisch-bergisch/leichlingen/?$ https://immobilienmakler-bergisch-gladbach.de/#staedte [R=301,L,NE]
RewriteRule ^stadtteile/roesrath\.html$ https://immobilienmakler-bergisch-gladbach.de/#staedte [R=301,L,NE]
RewriteRule ^immobilienmakler-rheinisch-bergisch/roesrath/?$ https://immobilienmakler-bergisch-gladbach.de/#staedte [R=301,L,NE]
RewriteRule ^stadtteile/leverkusen\.html$ https://immobilienmakler-bergisch-gladbach.de/#staedte [R=301,L,NE]
RewriteRule ^immobilienmakler-rheinisch-bergisch/?$ https://immobilienmakler-bergisch-gladbach.de/#staedte [R=301,L,NE]

# Rhein-Kreis Neuss entfernt (15.08.2026) -> Uebersichten (301)
RewriteRule ^stadtteile/dormagen\.html$ /stadtteile/ [R=301,L]
RewriteRule ^immobilienmakler-rhein-kreis-neuss/dormagen/?$ /stadtteile/ [R=301,L]
RewriteRule ^stadtteile/juechen\.html$ /stadtteile/ [R=301,L]
RewriteRule ^immobilienmakler-rhein-kreis-neuss/juechen/?$ /stadtteile/ [R=301,L]
RewriteRule ^stadtteile/rommerskirchen\.html$ /stadtteile/ [R=301,L]
RewriteRule ^immobilienmakler-rhein-kreis-neuss/rommerskirchen/?$ /stadtteile/ [R=301,L]
RewriteRule ^immobilienmakler-rhein-kreis-neuss/?$ /stadtteile/ [R=301,L]
RewriteRule ^bodenrichtwert-bergisch-gladbach\.html$ /bodenrichtwert-koeln.html [R=301,L]
RewriteRule ^bodenrichtwert-leichlingen\.html$ /bodenrichtwert-koeln.html [R=301,L]
RewriteRule ^bodenrichtwert-odenthal\.html$ /bodenrichtwert-koeln.html [R=301,L]
RewriteRule ^bodenrichtwert-overath\.html$ /bodenrichtwert-koeln.html [R=301,L]
RewriteRule ^bodenrichtwert-roesrath\.html$ /bodenrichtwert-koeln.html [R=301,L]
RewriteRule ^bodenrichtwert-dormagen\.html$ /bodenrichtwert-koeln.html [R=301,L]
RewriteRule ^bodenrichtwert-juechen\.html$ /bodenrichtwert-koeln.html [R=301,L]
RewriteRule ^bodenrichtwert-rommerskirchen\.html$ /bodenrichtwert-koeln.html [R=301,L]

RewriteRule ^bodenrichtwert-alfter\.html$ /bodenrichtwert-koeln.html [R=301,L]
RewriteRule ^bodenrichtwert-bornheim\.html$ /bodenrichtwert-koeln.html [R=301,L]
RewriteRule ^bodenrichtwert-lohmar\.html$ /bodenrichtwert-koeln.html [R=301,L]
RewriteRule ^bodenrichtwert-much\.html$ /bodenrichtwert-koeln.html [R=301,L]
RewriteRule ^bodenrichtwert-neunkirchen-seelscheid\.html$ /bodenrichtwert-koeln.html [R=301,L]
RewriteRule ^bodenrichtwert-niederkassel\.html$ /bodenrichtwert-koeln.html [R=301,L]
RewriteRule ^bodenrichtwert-sankt-augustin\.html$ /bodenrichtwert-koeln.html [R=301,L]
RewriteRule ^bodenrichtwert-swisttal\.html$ /bodenrichtwert-koeln.html [R=301,L]
RewriteRule ^bodenrichtwert-troisdorf\.html$ /bodenrichtwert-koeln.html [R=301,L]


# Umland-Orte in Kreis-Silos umgezogen (14.08.2026) -> 301
# Rhein-Erft-Kreis
RewriteRule ^stadtteile/bedburg\.html$ /immobilienmakler-rhein-erft/bedburg/ [R=301,L]
RewriteRule ^stadtteile/bergheim\.html$ /immobilienmakler-rhein-erft/bergheim/ [R=301,L]
RewriteRule ^stadtteile/bruehl\.html$ /immobilienmakler-rhein-erft/bruehl/ [R=301,L]
RewriteRule ^stadtteile/erftstadt\.html$ /immobilienmakler-rhein-erft/erftstadt/ [R=301,L]
RewriteRule ^stadtteile/frechen\.html$ /immobilienmakler-rhein-erft/frechen/ [R=301,L]
RewriteRule ^stadtteile/huerth\.html$ /immobilienmakler-rhein-erft/huerth/ [R=301,L]
RewriteRule ^stadtteile/kerpen\.html$ /immobilienmakler-rhein-erft/kerpen/ [R=301,L]
RewriteRule ^stadtteile/pulheim\.html$ /immobilienmakler-rhein-erft/pulheim/ [R=301,L]
RewriteRule ^stadtteile/wesseling\.html$ /immobilienmakler-rhein-erft/wesseling/ [R=301,L]


# Rheinisch-Bergischer Kreis

# Rhein-Kreis Neuss


# Düren: alter Slug mit Doppel-r (Tippfehler) -> korrekt dueren (301)
RewriteRule ^stadtteile/duerren\.html$    /stadtteile/               [R=301,L]
RewriteRule ^bodenrichtwert-duerren\.html$ /bodenrichtwert-koeln.html  [R=301,L]

# 2) Legacy-URLs einer alten Site-Struktur (vor /ratgeber/-Prefix-Umstellung)
#    Ziele thematisch gewählt für vollen Authority-Transfer + UX.
#    Mapping wird auf Basis Search-Console-Daten gepflegt (gepullt 2026-05-11).
#    Wenn weitere Legacy-URLs in GSC-Pull auftauchen, hier eintragen.

# --- Top-Level-Sonderfälle (kein /ratgeber/-Pendant) ---
RewriteRule ^evernest/?$               /                                                 [R=301,L]
RewriteRule ^kontakt/?$                /#kontakt                                         [R=301,L]
RewriteRule ^impressum/?$              /impressum.html                                   [R=301,L]
RewriteRule ^linksammlung/?$           /ratgeber/                                        [R=301,L]

# --- Alte Top-Level-Ratgeber-URLs → neue /ratgeber/-Struktur ---
RewriteRule ^annuitaetendarlehen/?$    /ratgeber/annuitaetendarlehen.html               [R=301,L]
RewriteRule ^abschreibung-bei-immobilien/?$ /ratgeber/abschreibung-bei-immobilien.html  [R=301,L]
RewriteRule ^eigenbedarfsklage/?$      /ratgeber/eigenbedarfsklage.html                 [R=301,L]

# --- eigenbedarfsklage-2 wurde in eigenbedarfsklage.html zusammengeführt (2026-07-05) ---
RewriteRule ^ratgeber/eigenbedarfsklage-2\.html$ /ratgeber/eigenbedarfsklage.html       [R=301,L]

# --- heizungsgesetz + gebaeudeenergiegesetz in heizungsgesetz-aenderung.html zusammengeführt (2026-07-14) ---
RewriteRule ^ratgeber/heizungsgesetz\.html$        /ratgeber/heizungsgesetz-aenderung.html [R=301,L]
RewriteRule ^ratgeber/gebaeudeenergiegesetz\.html$ /ratgeber/heizungsgesetz-aenderung.html [R=301,L]

# --- Bezirks-Hubseiten entfernt (2026-07-23): kannibalisierten die
#     gleichnamigen Stadtteilseiten porz.html / chorweiler.html ---
RewriteRule ^stadtteile/bezirk-porz\.html$       /stadtteile/porz.html       [R=301,L]
RewriteRule ^stadtteile/bezirk-chorweiler\.html$ /stadtteile/chorweiler.html [R=301,L]
RewriteRule ^flurkarte/?$              /ratgeber/flurkarte.html                         [R=301,L]
RewriteRule ^notarkosten-beim-immobilienkauf/?$ /ratgeber/notarkosten-beim-immobilienkauf.html [R=301,L]
RewriteRule ^smart-heizung/?$          /ratgeber/smart-heizung.html                     [R=301,L]

# --- Catch-All: jeder Top-Level-Slug → /ratgeber/<slug>.html (wenn Datei existiert) ---
#     Deckt alle 30+ WP-Ratgeber-Seiten ab, ohne jede einzeln listen zu müssen.
RewriteCond %{REQUEST_URI} ^/([^/]+)/?$
RewriteCond %{DOCUMENT_ROOT}/ratgeber/%1.html -f
RewriteRule ^([^/]+)/?$ /ratgeber/$1.html [R=301,L]

# --- Catch-All: Top-Level-Slug → /<slug>.html im Root (wenn Datei existiert) ---
#     Fängt extensionslose Root-Seiten ab, z. B. /immobilienbewertung → /immobilienbewertung.html
#     -f-Check verhindert Loops und Fehl-Redirects; läuft nach dem /ratgeber/-Catch-All,
#     damit Ratgeber-Slugs weiterhin Vorrang haben.
RewriteCond %{REQUEST_URI} ^/([^/]+)/?$
RewriteCond %{DOCUMENT_ROOT}/%1.html -f
RewriteRule ^([^/]+)/?$ /$1.html [R=301,L]

# --- Interne WP-Testseite ---
RewriteRule ^startseite-alex/?$ / [R=301,L]

# 3) URL-Hygiene: trailing-slash → .html (Stadtteile + ratgeber/ Sub-Pfade)
#    Beispiel: /stadtteile/suelz/ → /stadtteile/suelz.html
#    Cond: .html-Variante im Document Root existiert (verhindert 404-Ketten)
RewriteCond %{REQUEST_URI} !\.html/?$
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteCond %{DOCUMENT_ROOT}/%1.html -f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1.html [R=301,L]
